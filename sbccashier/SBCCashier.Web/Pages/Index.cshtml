@page
@model SBCCashier.Web.Pages.IndexModel
@{ViewData["Title"]="Dashboard";}
<div class="grid stats"><section class="panel metric"><h2>Students</h2><strong>@Model.Students</strong><span>Registered students</span></section><section class="panel metric"><h2>Payments</h2><strong>@Model.Payments</strong><span>Recorded payments</span></section><section class="panel metric"><h2>Registrar Requests</h2><strong>@Model.Requests</strong><span>COR, COE, ID, and more</span></section><section class="panel metric"><h2>Total Collected</h2><strong>@Model.TotalCollected.ToString("C2")</strong><span>Payments and service fees</span></section></div>
<div class="grid split" style="margin-top:18px"><section class="panel"><h2 class="panel-title">Cashier Services</h2><div class="panel-body"><p style="color:var(--muted)">Record tuition, vehicle-pass, and registrar payments for students.</p><div class="actions"><a class="button primary" href="/Payments">Record Payment</a><a class="button" href="/Registrar">Registrar Services</a><a class="button" href="/VehiclePasses">Vehicle Pass</a></div></div></section><section class="panel"><h2 class="panel-title">Payment Methods</h2><div class="panel-body"><p style="color:var(--muted)">Cash and card payments are recorded with a reference number for traceability.</p></div></section></div>
