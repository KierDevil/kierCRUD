@page
@model SBCCashier.Web.Pages.Students.IndexModel
@{ViewData["Title"]="Students";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Add Student</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewStudent.StudentId">Student ID</label><input asp-for="NewStudent.StudentId" placeholder="Student ID"/><label asp-for="NewStudent.FullName">Full name</label><input asp-for="NewStudent.FullName" placeholder="Full name"/><label asp-for="NewStudent.Course">Course</label><input asp-for="NewStudent.Course" placeholder="Course"/><label asp-for="NewStudent.YearLevel">Year level</label><input asp-for="NewStudent.YearLevel" placeholder="Year level"/><div class="actions"><button class="button primary" type="submit">Add Student</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Students</h2>@if(Model.Students.Count==0){<div class="empty">No students registered yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>Student ID</th><th>Full name</th><th>Course</th><th>Year level</th><th>Status</th></tr></thead><tbody>@foreach(var student in Model.Students){<tr><td>@student.StudentId</td><td>@student.FullName</td><td>@student.Course</td><td>@student.YearLevel</td><td>@student.Status</td></tr>}</tbody></table></div>}</section></div>
