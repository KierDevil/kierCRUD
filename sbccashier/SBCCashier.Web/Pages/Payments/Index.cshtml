@page
@model SBCCashier.Web.Pages.Payments.IndexModel
@{ViewData["Title"]="Payments";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Record Payment</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewPayment.StudentKey">Student</label><select asp-for="NewPayment.StudentKey"><option value="0">Select student</option>@foreach(var student in Model.Students){<option value="@student.Id">@student.FullName (ID: @student.StudentId)</option>}</select><label asp-for="NewPayment.PaymentType">Payment type</label><select asp-for="NewPayment.PaymentType"><option>Tuition</option><option>Vehicle Pass</option><option>Registrar Document</option><option>Other</option></select><label asp-for="NewPayment.Description">Description</label><input asp-for="NewPayment.Description" placeholder="Description"/><label asp-for="NewPayment.Amount">Amount</label><input asp-for="NewPayment.Amount" type="number" step="0.01" min="0" placeholder="0.00"/><label asp-for="NewPayment.PaymentMethod">Payment method</label><select asp-for="NewPayment.PaymentMethod"><option>Cash</option><option>Card</option></select><label asp-for="NewPayment.ReferenceNumber">Reference number</label><input asp-for="NewPayment.ReferenceNumber" placeholder="Receipt or card reference"/><div class="actions"><button class="button primary" type="submit">Record Payment</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Payment History</h2>@if(Model.Payments.Count==0){<div class="empty">No payments recorded yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>Student</th><th>Type</th><th>Description</th><th>Amount</th><th>Method</th><th>Date</th></tr></thead><tbody>@foreach(var payment in Model.Payments){<tr><td>@payment.StudentName<br/><small>ID: @payment.StudentId</small></td><td>@payment.PaymentType</td><td>@payment.Description</td><td>@payment.Amount.ToString("C2")</td><td>@payment.PaymentMethod</td><td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div>}</section></div>
