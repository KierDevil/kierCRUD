@page
@model SBCCashier.Web.Pages.Registrar.IndexModel
@{ViewData["Title"]="Registrar";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Registrar Request</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewRequest.StudentKey">Student</label><select asp-for="NewRequest.StudentKey"><option value="0">Select student</option>@foreach(var student in Model.Students){<option value="@student.Id">@student.FullName (ID: @student.StudentId)</option>}</select><label asp-for="NewRequest.DocumentType">Document</label><select asp-for="NewRequest.DocumentType"><option>COR</option><option>COE</option><option>Student ID</option><option>Transcript</option><option>Certificate</option><option>Other</option></select><label asp-for="NewRequest.Purpose">Purpose</label><input asp-for="NewRequest.Purpose" placeholder="Purpose"/><label asp-for="NewRequest.Fee">Fee</label><input asp-for="NewRequest.Fee" type="number" step="0.01" min="0" placeholder="0.00"/><div class="actions"><button class="button primary" type="submit">Create Request</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Registrar Requests</h2>@if(Model.Requests.Count==0){<div class="empty">No registrar requests yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>Student</th><th>Document</th><th>Purpose</th><th>Fee</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var request in Model.Requests){<tr><td>@request.StudentName<br/><small>ID: @request.StudentId</small></td><td>@request.DocumentType</td><td>@request.Purpose</td><td>@request.Fee.ToString("C2")</td><td>@request.Status</td><td>@if(request.Status=="Pending"){<form method="post" asp-page-handler="release" asp-route-id="@request.Id"><button class="button" type="submit">Release</button></form>}</td></tr>}</tbody></table></div>}</section></div>
