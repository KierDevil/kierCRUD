@page
@model SBCCashier.Web.Pages.VehiclePasses.IndexModel
@{ViewData["Title"]="Vehicle Passes";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Vehicle Pass</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewPass.StudentKey">Student</label><select asp-for="NewPass.StudentKey"><option value="0">Select student</option>@foreach(var student in Model.Students){<option value="@student.Id">@student.FullName (ID: @student.StudentId)</option>}</select><label asp-for="NewPass.PlateNumber">Plate number</label><input asp-for="NewPass.PlateNumber" placeholder="Plate number"/><label asp-for="NewPass.VehicleType">Vehicle type</label><select asp-for="NewPass.VehicleType"><option>Motorcycle</option><option>Car</option><option>Bicycle</option><option>Other</option></select><label asp-for="NewPass.Amount">Amount</label><input asp-for="NewPass.Amount" type="number" step="0.01" min="0" placeholder="0.00"/><label asp-for="NewPass.PaymentMethod">Payment method</label><select asp-for="NewPass.PaymentMethod"><option>Cash</option><option>Card</option></select><div class="actions"><button class="button primary" type="submit">Issue Vehicle Pass</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Vehicle Passes</h2>@if(Model.Passes.Count==0){<div class="empty">No vehicle passes issued yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>Student</th><th>Plate</th><th>Vehicle</th><th>Amount</th><th>Method</th><th>Status</th></tr></thead><tbody>@foreach(var pass in Model.Passes){<tr><td>@pass.StudentName<br/><small>ID: @pass.StudentId</small></td><td>@pass.PlateNumber</td><td>@pass.VehicleType</td><td>@pass.Amount.ToString("C2")</td><td>@pass.PaymentMethod</td><td>@pass.Status</td></tr>}</tbody></table></div>}</section></div>
