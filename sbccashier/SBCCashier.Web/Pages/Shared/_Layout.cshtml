<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - SBC Cashier</title><style>
:root{--ink:#111;--muted:#555;--line:#b8b8b8;--page:#f2f2f2}*{box-sizing:border-box}body{margin:0;background:var(--page);color:#222;font-family:"Segoe UI",Arial,sans-serif}.shell{max-width:1250px;margin:0 auto;padding:28px}.brand{text-align:center;margin-bottom:24px}.brand h1{margin:0;color:var(--ink);font-size:28px}.brand p{margin:7px 0;color:var(--muted);font-size:14px}.nav{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:24px}.nav a,.button{border:1px solid var(--line);border-radius:4px;background:#fff;color:var(--ink);text-decoration:none;padding:8px 14px;font:inherit;cursor:pointer}.nav a:hover,.button.primary{background:#e2e2e2;border-color:#777}.panel{border:1px solid var(--line);border-radius:6px;background:#fff;box-shadow:0 2px 5px #00000012}.panel-title{margin:0;padding:12px 16px;border-bottom:1px solid var(--line);font-size:17px;color:var(--ink)}.panel-body{padding:16px}.grid{display:grid;gap:18px}.split{grid-template-columns:320px minmax(0,1fr)}.stats{grid-template-columns:repeat(4,minmax(0,1fr))}.metric{padding:18px;min-height:125px}.metric h2{font-size:17px;margin:0 0 10px}.metric strong{font-size:28px;display:block}.metric span{color:var(--muted);font-size:13px}label{display:block;margin:10px 0 5px;font-size:13px;font-weight:600;color:var(--ink)}input,select{width:100%;padding:9px;border:1px solid var(--line);border-radius:4px;font:inherit}.actions{display:flex;gap:8px;margin-top:14px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left;font-size:13px;vertical-align:top}th{background:#eee;color:var(--ink)}.badge{padding:3px 8px;border-radius:10px;background:#e5e5e5;font-size:12px;color:#222}.notice{padding:10px;margin-bottom:12px;border:1px solid #aaa;background:#f2f2f2;color:#222;border-radius:4px}.empty{padding:34px;text-align:center;color:var(--muted)}@@media(max-width:820px){.shell{padding:18px 14px}.stats,.split{grid-template-columns:1fr}.brand h1{font-size:22px}}
</style></head><body><div class="shell"><header class="brand"><h1>SBC CASHIER</h1><p>Student payments, vehicle passes, and registrar services.</p></header><nav class="nav"><a href="/">Dashboard</a><a href="/Students">Students</a><a href="/Payments">Payments</a><a href="/Registrar">Registrar</a><a href="/VehiclePasses">Vehicle Passes</a></nav><main>@RenderBody()</main></div></body></html>
