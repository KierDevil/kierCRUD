@page
@namespace KierCRUD.Web.Pages.Enrollments
@model CreateModel
@{
    ViewData["Title"] = "Create Enrollment";
}

<div class="container mt-4">
    <h1>Create New Enrollment</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post" class="mt-4">
        <div class="form-group mb-3">
            <label for="Enrollment_Studid" class="form-label">Student *</label>
            <select class="form-control" asp-for="Enrollment.Studid">
                <option value="">-- Select Student --</option>
                @foreach (var student in Model.Students)
                {
                    <option value="@student.Studid">@student.StudentName (@student.Studid)</option>
                }
            </select>
            <span asp-validation-for="Enrollment.Studid" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Enrollment_Courscode" class="form-label">Course *</label>
            <select class="form-control" asp-for="Enrollment.Courscode">
                <option value="">-- Select Course --</option>
                @foreach (var course in Model.Courses)
                {
                    <option value="@course.Courscode">@course.CourseTitle</option>
                }
            </select>
            <span asp-validation-for="Enrollment.Courscode" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Enrollment_Semcode" class="form-label">Semester *</label>
            <select class="form-control" asp-for="Enrollment.Semcode">
                <option value="">-- Select Semester --</option>
                @foreach (var semester in Model.Semesters)
                {
                    <option value="@semester.Semcode">@semester.SemesterName</option>
                }
            </select>
            <span asp-validation-for="Enrollment.Semcode" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Enrollment_Sycode" class="form-label">School Year *</label>
            <select class="form-control" asp-for="Enrollment.Sycode">
                <option value="">-- Select School Year --</option>
                @foreach (var sy in Model.SchoolYears)
                {
                    <option value="@sy.Sycode">@sy.SyName</option>
                }
            </select>
            <span asp-validation-for="Enrollment.Sycode" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label for="Enrollment_EnrollmentDate" class="form-label">Enrollment Date</label>
            <input type="date" class="form-control" asp-for="Enrollment.EnrollmentDate">
        </div>

        <div class="form-group mb-3">
            <label for="Enrollment_Status" class="form-label">Status</label>
            <select class="form-control" asp-for="Enrollment.Status">
                <option value="Enrolled">Enrolled</option>
                <option value="Dropped">Dropped</option>
            </select>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-success">Create</button>
            <a href="/Enrollments/Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
