@{
    Layout = null;
}
@namespace KierCRUD.Web.Pages.Catalog
@model IndexModel

<div class="tab-pane fade show active">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="row">
        <div class="col-md-4">
            <h5>Add Course</h5>
            <form method="post" asp-page-handler="CreateCourse">
                <div class="mb-3">
                    <label for="NewCourse_Courscode" class="form-label">Code *</label>
                    <input class="form-control" asp-for="NewCourse.Courscode" placeholder="e.g., CS101">
                </div>
                <div class="mb-3">
                    <label for="NewCourse_CourseTitle" class="form-label">Title *</label>
                    <input class="form-control" asp-for="NewCourse.CourseTitle" placeholder="e.g., Introduction to CS">
                </div>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>
        </div>

        <div class="col-md-8">
            <h5>Courses</h5>
            @if (Model.Courses.Count == 0)
            {
                <div class="alert alert-info">No courses found.</div>
            }
            else
            {
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Title</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>@course.Courscode</td>
                                <td>@course.CourseTitle</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteCourse" asp-route-courscode="@course.Courscode" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this course?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

