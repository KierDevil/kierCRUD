@{
    Layout = null;
}
@namespace KierCRUD.Web.Pages.Catalog
@model IndexModel

<div class="tab-pane fade show active">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="row">
        <div class="col-md-4">
            <h5>Add School Year</h5>
            <form method="post" asp-page-handler="CreateSchoolYear">
                <div class="mb-3">
                    <label for="NewSchoolYear_Sycode" class="form-label">Code *</label>
                    <input class="form-control" asp-for="NewSchoolYear.Sycode" placeholder="e.g., SY2024">
                </div>
                <div class="mb-3">
                    <label for="NewSchoolYear_SyName" class="form-label">Name *</label>
                    <input class="form-control" asp-for="NewSchoolYear.SyName" placeholder="e.g., 2024-2025">
                </div>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>
        </div>

        <div class="col-md-8">
            <h5>School Years</h5>
            @if (Model.SchoolYears.Count == 0)
            {
                <div class="alert alert-info">No school years found.</div>
            }
            else
            {
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sy in Model.SchoolYears)
                        {
                            <tr>
                                <td>@sy.Sycode</td>
                                <td>@sy.SyName</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteSchoolYear" asp-route-sycode="@sy.Sycode" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this school year?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

