@{
    Layout = null;
}
@namespace KierCRUD.Web.Pages.Catalog
@model IndexModel

<div class="tab-pane fade show active">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="row">
        <div class="col-md-4">
            <h5>Add Semester</h5>
            <form method="post" asp-page-handler="CreateSemester">
                <div class="mb-3">
                    <label for="NewSemester_Semcode" class="form-label">Code *</label>
                    <input class="form-control" asp-for="NewSemester.Semcode" placeholder="e.g., SEM1">
                </div>
                <div class="mb-3">
                    <label for="NewSemester_SemesterName" class="form-label">Name *</label>
                    <input class="form-control" asp-for="NewSemester.SemesterName" placeholder="e.g., First Semester">
                </div>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>
        </div>

        <div class="col-md-8">
            <h5>Semesters</h5>
            @if (Model.Semesters.Count == 0)
            {
                <div class="alert alert-info">No semesters found.</div>
            }
            else
            {
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sem in Model.Semesters)
                        {
                            <tr>
                                <td>@sem.Semcode</td>
                                <td>@sem.SemesterName</td>
                                <td>
                                    <form method="post" asp-page-handler="DeleteSemester" asp-route-semcode="@sem.Semcode" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this semester?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

