@page
@model Library.Web.Pages.Members.IndexModel
@{ViewData["Title"]="Students";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Add Student</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewMember.MemberNumber">Student ID</label><input asp-for="NewMember.MemberNumber" placeholder="Student ID"/><label asp-for="NewMember.FullName">Full name</label><input asp-for="NewMember.FullName" placeholder="Full name"/><label asp-for="NewMember.Course">Course</label><input asp-for="NewMember.Course" placeholder="Course"/><label asp-for="NewMember.YearLevel">Year level</label><select asp-for="NewMember.YearLevel"><option value="">Select year level</option><option>1st Year</option><option>2nd Year</option><option>3rd Year</option><option>4th Year</option></select><div class="actions"><button class="button primary" type="submit">Add Student</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Library Students</h2>@if(Model.Members.Count==0){<div class="empty">No students registered yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>Student ID</th><th>Full name</th><th>Course</th><th>Year level</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var member in Model.Members){<tr><td>@member.MemberNumber</td><td>@member.FullName</td><td>@member.Course</td><td>@member.YearLevel</td><td><span class="badge">@member.Status</span></td><td><form method="post" asp-page-handler="delete" style="display:inline;"><input type="hidden" name="id" value="@member.MemberId"/><button class="button danger" type="submit" onclick="return confirm('Delete this student?');">Delete</button></form><button class="button" type="button" onclick="document.getElementById('member-edit-@member.MemberId').style.display=document.getElementById('member-edit-@member.MemberId').style.display==='none'?'block':'none';">Edit</button></td></tr><tr id="member-edit-@member.MemberId" style="display:none;"><td colspan="6"><form method="post" asp-page-handler="update"><input type="hidden" name="id" value="@member.MemberId"/><div class="grid"><label>Student ID<input type="text" name="EditMember.MemberNumber" value="@member.MemberNumber" required /></label><label>Full name<input type="text" name="EditMember.FullName" value="@member.FullName" required /></label><label>Course<input type="text" name="EditMember.Course" value="@member.Course" /></label><label>Year level<select name="EditMember.YearLevel"><option value="">Select year level</option><option selected="@(member.YearLevel=="1st Year")">1st Year</option><option selected="@(member.YearLevel=="2nd Year")">2nd Year</option><option selected="@(member.YearLevel=="3rd Year")">3rd Year</option><option selected="@(member.YearLevel=="4th Year")">4th Year</option></select></label><label>Status<select name="EditMember.Status"><option value="Active" selected="@(member.Status=="Active")">Active</option><option value="Inactive" selected="@(member.Status=="Inactive")">Inactive</option></select></label></div><div class="actions"><button class="button primary" type="submit">Save</button></div></form></td></tr>}</tbody></table></div>}</section></div>
