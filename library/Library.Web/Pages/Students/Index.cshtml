@page
@model Library.Web.Pages.Members.IndexModel
@{ViewData["Title"]="Students";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Add Student</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewMember.MemberNumber">Student ID</label><input asp-for="NewMember.MemberNumber" placeholder="Student ID"/><label asp-for="NewMember.FullName">Full name</label><input asp-for="NewMember.FullName" placeholder="Full name"/><label asp-for="NewMember.Course">Course</label><input asp-for="NewMember.Course" placeholder="Course"/><div class="actions"><button class="button primary" type="submit">Add Student</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Library Students</h2>@if(Model.Members.Count==0){<div class="empty">No students registered yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>Student ID</th><th>Full name</th><th>Course</th><th>Status</th></tr></thead><tbody>@foreach(var member in Model.Members){<tr><td>@member.MemberNumber</td><td>@member.FullName</td><td>@member.Course</td><td><span class="badge">@member.Status</span></td></tr>}</tbody></table></div>}</section></div>
