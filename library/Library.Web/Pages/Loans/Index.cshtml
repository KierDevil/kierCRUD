@page
@model Library.Web.Pages.Loans.IndexModel
@{ViewData["Title"]="Loans";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Borrow Book</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="borrow"><label asp-for="BookId">Book</label><select asp-for="BookId"><option value="0">Select book</option>@foreach(var book in Model.Books){<option value="@book.BookId">@book.Title (@book.AvailableCopies available)</option>}</select><label asp-for="MemberId">Student</label><select asp-for="MemberId"><option value="0">Select student</option>@foreach(var member in Model.Members){<option value="@member.MemberId">@member.FullName (ID: @member.MemberNumber)</option>}</select><label asp-for="LoanType">Loan type</label><select asp-for="LoanType">@foreach(var reference in Model.LoanReferences){<option value="@reference.LoanType">@reference.LoanType (@reference.DaysAllowed days)</option>}</select><label asp-for="DueDate">Due date</label><input asp-for="DueDate" type="date"/><div class="actions"><button class="button primary" type="submit">Borrow Book</button><button class="button" type="reset">Clear</button></div></form><p class="muted">Overdue penalty: ₱10 per day.</p></div></section><section class="panel"><h2 class="panel-title">Book Transactions</h2>@if(Model.Loans.Count==0){<div class="empty">No transactions recorded yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>Book / Accession</th><th>Student</th><th>Loan type</th><th>Borrowed</th><th>Due / Returned</th><th>Penalty</th><th></th></tr></thead><tbody>@foreach(var loan in Model.Loans){<tr><td>@loan.BookTitle<br/><small>@loan.AccessionNumber</small></td><td>@loan.MemberName</td><td>@loan.LoanType</td><td>@loan.BorrowedDate.ToString("yyyy-MM-dd")</td><td>@loan.DueDate.ToString("yyyy-MM-dd")<br/><small>@(loan.ReturnedDate?.ToString("yyyy-MM-dd") ?? "Not returned")</small></td><td>₱@loan.PenaltyAmount.ToString("N2") (@loan.PenaltyDays d)</td><td>@if(loan.ReturnedDate is null){<form method="post" asp-page-handler="return" asp-route-id="@loan.LoanId"><button class="button" type="submit">Return</button></form>}</td></tr>}</tbody></table></div>}</section></div>
