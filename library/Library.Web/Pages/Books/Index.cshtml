@page
@model Library.Web.Pages.Books.IndexModel
@{ViewData["Title"]="Books";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Add Book</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewBook.Isbn">ISBN</label><input asp-for="NewBook.Isbn" placeholder="ISBN"/><label asp-for="NewBook.Title">Title</label><input asp-for="NewBook.Title" placeholder="Book title"/><label asp-for="NewBook.Author">Author</label><input asp-for="NewBook.Author" placeholder="Author"/><label asp-for="NewBook.Category">Category</label><input asp-for="NewBook.Category" placeholder="Category"/><label asp-for="NewBook.TotalCopies">Total copies</label><input asp-for="NewBook.TotalCopies" type="number" min="1"/><div class="actions"><button class="button primary" type="submit">Add Book</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Book Catalog</h2>@if(Model.Books.Count==0){<div class="empty">No books registered yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>ISBN</th><th>Title</th><th>Author</th><th>Category</th><th>Available</th></tr></thead><tbody>@foreach(var book in Model.Books){<tr><td>@book.Isbn</td><td>@book.Title</td><td>@book.Author</td><td>@book.Category</td><td><span class="badge @(book.AvailableCopies==0?"out":"")">@book.AvailableCopies / @book.TotalCopies</span></td></tr>}</tbody></table></div>}</section></div>
