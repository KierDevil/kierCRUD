@page
@model Library.Web.Pages.Books.IndexModel
@{ViewData["Title"]="Books";}
<div class="grid split"><section class="panel"><h2 class="panel-title">Add Book</h2><div class="panel-body">@if(Model.ErrorMessage is not null){<div class="notice">@Model.ErrorMessage</div>}<form method="post" asp-page-handler="create"><label asp-for="NewBook.Isbn">ISBN</label><input asp-for="NewBook.Isbn" placeholder="ISBN"/><label asp-for="NewBook.AccessionNumber">Accession number</label><input asp-for="NewBook.AccessionNumber" placeholder="Accession number"/><label asp-for="NewBook.BookType">Book type</label><input asp-for="NewBook.BookType" placeholder="General"/><label asp-for="NewBook.Title">Title</label><input asp-for="NewBook.Title" placeholder="Book title"/><label asp-for="NewBook.Author">Author</label><input asp-for="NewBook.Author" placeholder="Author"/><label asp-for="NewBook.Category">Category</label><input asp-for="NewBook.Category" placeholder="Category"/><label asp-for="NewBook.TotalCopies">Total copies</label><input asp-for="NewBook.TotalCopies" type="number" min="1"/><div class="actions"><button class="button primary" type="submit">Add Book</button><button class="button" type="reset">Clear</button></div></form></div></section><section class="panel"><h2 class="panel-title">Book Catalog</h2>@if(Model.Books.Count==0){<div class="empty">No books registered yet.</div>}else{<div class="table-wrap"><table><thead><tr><th>ISBN</th><th>Accession</th><th>Type</th><th>Title</th><th>Available</th><th>Actions</th></tr></thead><tbody>@foreach(var book in Model.Books){<tr><td>@book.Isbn</td><td>@book.AccessionNumber</td><td>@book.BookType</td><td>@book.Title</td><td><span class="badge @(book.AvailableCopies==0?"out":"")">@book.AvailableCopies / @book.TotalCopies</span></td><td><form method="post" asp-page-handler="delete" style="display:inline;"><input type="hidden" name="id" value="@book.BookId"/><button class="button danger" type="submit" onclick="return confirm('Delete this book?');">Delete</button></form><button class="button" type="button" onclick="document.getElementById('book-edit-@book.BookId').style.display=document.getElementById('book-edit-@book.BookId').style.display==='none'?'block':'none';">Edit</button></td></tr><tr id="book-edit-@book.BookId" style="display:none;"><td colspan="6"><form method="post" asp-page-handler="update"><input type="hidden" name="id" value="@book.BookId"/><div class="grid"><label>ISBN<input type="text" name="EditBook.Isbn" value="@book.Isbn" /></label><label>Accession<input type="text" name="EditBook.AccessionNumber" value="@book.AccessionNumber" /></label><label>Type<input type="text" name="EditBook.BookType" value="@book.BookType" /></label><label>Title<input type="text" name="EditBook.Title" value="@book.Title" required /></label><label>Author<input type="text" name="EditBook.Author" value="@book.Author" /></label><label>Category<input type="text" name="EditBook.Category" value="@book.Category" /></label><label>Total copies<input type="number" name="EditBook.TotalCopies" min="1" value="@book.TotalCopies" /></label></div><div class="actions"><button class="button primary" type="submit">Save</button></div></form></td></tr>}</tbody></table></div>}</section></div>
